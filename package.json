{
  "name": "get-one-fourth-scoreboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline LAN scoreboard for Get One Fourth: Reprise",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"node --watch server/src/index.js\" \"vite --config client/vite.config.js\"",
    "test": "vitest run",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
